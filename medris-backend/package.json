{
  "name": "medris-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Levromart API: Hono + TypeScript on Node.js, deployed as one Vercel function.",
  "type": "module",
  "main": "dist/vercel.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@hono/node-server": "^1.19.5",
    "hono": "^4.10.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
