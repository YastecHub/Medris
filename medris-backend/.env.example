# medris-backend environment. Copy to .env for local development; in
# production set these in the Vercel project settings. Never commit real values.

# Supabase (existing project). The service-role key bypasses Row Level Security: server only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Must equal the secret embedded in the database functions that call /api/notify
# (notify_email_on_notification, ring_callee_again, send_background_reminders).
EMAIL_WEBHOOK_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=

# Resend e-mail. EMAIL_FROM is optional (defaults to Resend's shared sender).
RESEND_API_KEY=
EMAIL_FROM=

# Web push (VAPID). The public key defaults to the live key; it must match the frontend's VITE_VAPID_PUBLIC_KEY.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Google Gemini (Levi)
GEMINI_API_KEY=

# Shared secret for /api/daily-cron (Vercel Cron) and /api/order-reminders (GitHub Actions)
CRON_SECRET=

# Cloudflare R2 (public images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional TURN servers for calls, tried in this order, then the shared Open Relay
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
METERED_API_KEY=
METERED_DOMAIN=

# Optional: origin used in e-mail / push links (default https://levromart.vercel.app)
APP_ORIGIN=
# Optional: origin serving /api/notif-icon, used for push-notification pictures (default https://levromart.com)
ICON_ORIGIN=
# Optional: comma-separated browser origins allowed to call the API cross-origin
# (only needed when the frontend is served from a different origin than /api).
CORS_ALLOWED_ORIGINS=
# Optional: folder with the web app's static files (built index.html, fonts, og-frame.png, icons)
# used for link previews, share cards and notification pictures. Defaults to
# medris-frontend/dist, falling back to medris-frontend/public for images and fonts.
STATIC_ASSETS_DIR=

# Local dev server port
PORT=8787
