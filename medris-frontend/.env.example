# Copy to .env.local to override. All VITE_* values are bundled into the page
# and are visible to anyone: never put a secret here.

# Supabase project URL and its publishable (anon) key
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Web push public key; must pair with the backend's VAPID_PRIVATE_KEY
VITE_VAPID_PUBLIC_KEY=
# Base URL of medris-backend for the React API client. Empty = same origin (/api).
VITE_API_BASE_URL=
# Where the new backend's own API (/api/v1) runs when it is on another origin, e.g. the Heroku app
# (https://<app>.herokuapp.com). Only /api/v1 goes there; the original /api/* functions stay on Vercel.
# Public (no secret). Has no effect until a feature is switched on (VITE_BACKEND_FEATURES or levroData.useBackend).
VITE_BACKEND_URL=
# Dev only: where `npm run dev` proxies /api requests (default http://localhost:8787)
VITE_DEV_API_PROXY=
# Parts of the app that read/write through medris-backend (/api/v1) instead of
# calling Supabase from the browser: comma list of catalogue, cart, favorites,
# follows, notifications - or "all". Empty = none (today's behaviour).
# Per-browser override for testing: levroData.useBackend("all") in the console.
VITE_BACKEND_FEATURES=
# Screens drawn by React instead of the legacy runtime (screen-by-screen migration, see
# docs/REACT_MIGRATION.md): comma list of screen names, "all", or empty. Empty = none, which
# is today's behaviour; leave it empty in Vercel. Per-browser testing: open any page with
# ?react=terms,privacy (or ?react=all, ?react=off), or levroReact.use("terms") in the console.
VITE_REACT_VIEWS=
