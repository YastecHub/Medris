# Copy to .env.local to override. All VITE_* values are bundled into the page
# and are visible to anyone: never put a secret here.

# Supabase project URL and its publishable (anon) key
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Web push public key; must pair with the backend's VAPID_PRIVATE_KEY
VITE_VAPID_PUBLIC_KEY=
# Base URL of medris-backend for the React API client. Empty = same origin (/api).
VITE_API_BASE_URL=
# Dev only: where `npm run dev` proxies /api requests (default http://localhost:8787)
VITE_DEV_API_PROXY=
