{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w medris-frontend",
  "outputDirectory": "medris-frontend/dist",
  "rewrites": [
    {
      "source": "/api/turn",
      "destination": "/api/delete-account?turn=1"
    },
    {
      "source": "/api/notif-icon",
      "destination": "/api/delete-account?nicon=1"
    },
    {
      "source": "/api/register",
      "destination": "/api/delete-account"
    },
    {
      "source": "/api/account-exists",
      "destination": "/api/delete-account"
    },
    {
      "source": "/api/listing-payments",
      "destination": "/api/vendor-payments"
    },
    { "source": "/s/:id", "destination": "/api/delete-account?storefront=:id" },
    { "source": "/p/:id", "destination": "/api/delete-account?product=:id" },
    { "source": "/k/:id", "destination": "/api/delete-account?package=:id" },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "storefront" }],
      "destination": "/api/delete-account"
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "product" }],
      "destination": "/api/delete-account"
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "package" }],
      "destination": "/api/delete-account"
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/delete-account.js": {
      "includeFiles": "medris-frontend/dist/{index.html,og-frame.png,og-levromart.png,icon-512.png,levromart-notification-icon.png,notif-icons/*.png,levromart-badge.png,fonts/*.ttf}"
    }
  },
  "crons": [
    {
      "path": "/api/daily-cron",
      "schedule": "0 3 * * *"
    }
  ]
}
